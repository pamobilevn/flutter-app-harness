default_platform(:android)

PACKAGE = "__PACKAGE__"
JSON_KEY = File.expand_path("play-store-key.json", __dir__)
# versionCode = the +N build number in pubspec.yaml (bumped on every upload by the build phase)
VERSION_CODE = File.read(File.expand_path("../../pubspec.yaml", __dir__))[/^version:\s*\S+?\+(\d+)/, 1].to_i

platform :android do
  desc "Upload only the Play store listing metadata (no binary, no images)"
  lane :metadata do
    upload_to_play_store(
      package_name: PACKAGE,
      json_key: JSON_KEY,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Upload Play store graphics — screenshots, icon, feature graphic"
  lane :images do
    # NB: don't skip_upload_metadata — the hi-res icon and feature graphic are
    # attached during the listing (metadata) upload; only screenshots upload
    # independently. Text is re-sent (idempotent, same content).
    upload_to_play_store(
      package_name: PACKAGE,
      json_key: JSON_KEY,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Set the release notes (changelog) on the internal release of this build"
  lane :release_notes do
    # The build is only on internal; promoting it to production in the Console copies these notes.
    upload_to_play_store(
      package_name: PACKAGE,
      json_key: JSON_KEY,
      track: "internal",
      version_code: VERSION_CODE,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Set the Play listing contact email + website (supply has no field for them)"
  lane :contact_details do
    load File.expand_path("set_contact_details.rb", __dir__)
  end

  desc "Upload the signed AAB to the internal track + metadata"
  lane :internal do
    upload_to_play_store(
      package_name: PACKAGE,
      json_key: JSON_KEY,
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
