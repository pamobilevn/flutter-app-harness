#!/usr/bin/env bash
# Runs the app's Maestro suite on one device — copy to .maestro/suite.sh (chmod +x).
#
#   .maestro/suite.sh <device-id> <prefix> [light|dark|xxxl] [flow.yaml ...]
#   .maestro/suite.sh "$SIM" round-2-ios                 # every flow in .maestro/flows/
#   .maestro/suite.sh "$SIM" round-2-ios-dark dark       # flows tagged `ui`, dark appearance
#   .maestro/suite.sh "$SIM" round-2-ios-xxxl xxxl       # flows tagged `ui`, largest text size
#
# - One flow at a time: `maestro test <dir>` ran flows concurrently on one device (2.11) and they
#   fought over the app.
# - Every takeScreenshot PNG lands in docs/harness/screenshots/<prefix>-<name>.png; the device log
#   in docs/harness/screenshots/<prefix>-device.log.
# - dark / xxxl set the device setting for the run and restore it on exit.
# Exit code = number of failed flows (0 = green).
set -u
[ $# -ge 2 ] || { sed -n '2,6p' "$0"; exit 64; }
DEV="$1"; PREFIX="$2"; MODE="${3:-light}"
shift $(( $# < 3 ? $# : 3 ))
case "$MODE" in light|dark|xxxl) ;; *) echo "mode must be light|dark|xxxl, got: $MODE"; exit 64 ;; esac
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SHOTS="$ROOT/docs/harness/screenshots"
LOG="$SHOTS/$PREFIX-device.log"
OUT="$(mktemp -d "${TMPDIR:-/tmp}/maestro-out.XXXXXX")"
mkdir -p "$SHOTS"
export MAESTRO_CLI_NO_ANALYTICS=1

if xcrun simctl list devices 2>/dev/null | grep -q -- "$DEV"; then IOS=1; else IOS=0; fi
ADB="adb -s $DEV"

# Flows: the arguments, else every flow; dark / xxxl keep only flows tagged `ui`.
[ $# -gt 0 ] || set -- "$ROOT"/.maestro/flows/*.yaml
FLOWS=()
for f in "$@"; do
  [ -e "$f" ] || continue
  if [ "$MODE" != light ] && ! grep -qE '^[[:space:]]*-[[:space:]]*ui[[:space:]]*(#.*)?$' "$f"; then continue; fi
  FLOWS+=("$f")
done
[ ${#FLOWS[@]} -gt 0 ] || { echo "no flows to run ($MODE)"; exit 64; }

restore() {
  [ -n "${LOGPID:-}" ] && kill "$LOGPID" 2>/dev/null
  if [ $IOS = 1 ]; then
    [ -n "${APPEARANCE0:-}" ] && xcrun simctl ui "$DEV" appearance "$APPEARANCE0"
    [ -n "${SIZE0:-}" ] && xcrun simctl ui "$DEV" content_size "$SIZE0"
  else
    [ -n "${NIGHT0:-}" ] && $ADB shell cmd uimode night "$NIGHT0" >/dev/null
    [ -n "${SCALE0:-}" ] && $ADB shell settings put system font_scale "$SCALE0"
  fi
}
trap restore EXIT

case "$MODE" in
  dark)
    if [ $IOS = 1 ]; then APPEARANCE0=$(xcrun simctl ui "$DEV" appearance); xcrun simctl ui "$DEV" appearance dark
    else NIGHT0=$($ADB shell cmd uimode night | awk '{print $NF}' | tr -d '\r'); $ADB shell cmd uimode night yes >/dev/null; fi ;;
  xxxl)
    if [ $IOS = 1 ]; then SIZE0=$(xcrun simctl ui "$DEV" content_size); xcrun simctl ui "$DEV" content_size accessibility-extra-extra-extra-large
    else SCALE0=$($ADB shell settings get system font_scale | tr -d '\r'); $ADB shell settings put system font_scale 2.0; fi ;;
esac

# Device log for the console check. A log with no line from the app means capture broke.
APPID=$(sed -n 's/^appId: *//p' "$ROOT/.maestro/subflows/ready.yaml" 2>/dev/null | head -1)
if [ $IOS = 1 ]; then
  xcrun simctl spawn "$DEV" log stream --level debug --style compact --predicate 'process == "Runner"' > "$LOG" 2>&1 &
else
  $ADB logcat -c; $ADB logcat -v brief > "$LOG" 2>&1 &
fi
LOGPID=$!

fail=0
for f in "${FLOWS[@]}"; do
  echo "== $(basename "$f") [$MODE]"
  maestro --device "$DEV" test --test-output-dir "$OUT" "$f" || { echo "FAIL $(basename "$f")"; fail=$((fail + 1)); }
done

find "$OUT" -path '*/takeScreenshot/*.png' | while read -r p; do cp "$p" "$SHOTS/$PREFIX-$(basename "$p")"; done
sleep 2   # let the log stream flush
if [ $IOS = 1 ]; then grep -q 'Runner\[' "$LOG"; else grep -qF "${APPID:-<none>}" "$LOG"; fi \
  || echo "FAIL log: no app line in $LOG — log capture is broken, the console check cannot pass"
grep -nE "EXCEPTION CAUGHT|Unhandled Exception|overflowed by|setState\(\) called after dispose|FATAL EXCEPTION" "$LOG" \
  && echo "FAIL console: errors in $LOG (HG8)"
echo "flows: $(( ${#FLOWS[@]} - fail ))/${#FLOWS[@]} passed | screenshots: $SHOTS/$PREFIX-* | maestro output: $OUT"
exit $fail
